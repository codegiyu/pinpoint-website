# Copy to `.env` and fill in values. Do not commit `.env`.
#
# Next.js loads `.env`, `.env.local`, `.env.development`, etc. See:
# https://nextjs.org/docs/app/building-your-application/configuring/environment-variables

# -----------------------------------------------------------------------------
# Public (exposed to the browser — only use non-secret values)
# -----------------------------------------------------------------------------

# Pinpoint API origin for site content (no trailing slash).
# Used by server components, CMS fetches, and as the default analytics ingest base.
# Local dev example: http://localhost:4000
# Production example: https://api.pinpoint.ng
NEXT_PUBLIC_PINPOINT_BACKEND_URL=http://localhost:4000

# Optional. Hostname only (no protocol/path) for CMS images not served from
# static.pinpoint.ng. Added to next.config.ts `images.remotePatterns` at build time.
# Example: cdn.example.com
NEXT_PUBLIC_CMS_IMAGE_HOSTNAME=

# --- Site telemetry (first-party ingest + optional GA4 after consent) ---
# Telemetry is enabled when ingestUrl + siteKey are both set (see lib/telemetry/config.ts).
# Pair with backend SITE_ANALYTICS_INGEST_KEYS=pinpoint-global:<same-key-as-below>.

# Full ingest URL (optional — overrides base URL construction).
# Leave empty to use: {NEXT_PUBLIC_PINPOINT_BACKEND_URL}/api/v1/public/analytics/ingest
# Example: http://localhost:4000/api/v1/public/analytics/ingest
NEXT_PUBLIC_ANALYTICS_INGEST_URL=

# Site key for public ingest. Must match the key for this siteId in backend SITE_ANALYTICS_INGEST_KEYS.
# Example backend: SITE_ANALYTICS_INGEST_KEYS=pinpoint-global:dev-ingest-key-replace-me
NEXT_PUBLIC_ANALYTICS_SITE_KEY=dev-ingest-key-replace-me

# Site id sent with events (default: pinpoint-global if unset).
NEXT_PUBLIC_ANALYTICS_SITE_ID=pinpoint-global

# Google Analytics 4 measurement ID — scripts load only after user accepts analytics.
# Example: G-XXXXXXXXXX (leave empty to disable GA4 even when consent is granted).
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Comma-separated providers: first-party, ga4 (server-side fallback: TELEMETRY_PROVIDERS).
# Use first-party only locally if GA4 is not configured.
NEXT_PUBLIC_TELEMETRY_PROVIDERS=first-party,ga4
TELEMETRY_PROVIDERS=first-party,ga4

# Future remote analytics service base (not used in v1 embedded mode).
# Ingest URL becomes: {base}/api/v1/public/analytics/ingest when NEXT_PUBLIC_ANALYTICS_INGEST_URL is unset.
# ANALYTICS_API_BASE_URL=https://analytics-api.example.com
# NEXT_PUBLIC_ANALYTICS_API_BASE_URL=https://analytics-api.example.com
ANALYTICS_API_BASE_URL=
NEXT_PUBLIC_ANALYTICS_API_BASE_URL=

# -----------------------------------------------------------------------------
# Server-only
# -----------------------------------------------------------------------------

# Site origin for fallback metadata when the public CMS API is unreachable
# (see app/layout.tsx generateMetadata catch block). No trailing slash.
# Example: https://pinpoint.ng
live_url=

# Dev only — bundle analyzer (npm run analyze). Do not set in production builds.
# ANALYZE=true

# --- Nodemailer (app/api/send-company-mail/route.ts) ---

# SMTP account used to send mail (login user and From address).
fromEmail=

# SMTP password or app password for fromEmail.
password=

# SMTP hostname (e.g. smtp.gmail.com).
emailHost=

# SMTP port (defaults to 465 if unset).
emailPort=

# Inbox that receives website form submissions.
toEmail=

# If set, passed to Boolean(); if unset, nodemailer uses secure: true.
# Note: any non-empty string is truthy in JS (including "false").
secureMail=
