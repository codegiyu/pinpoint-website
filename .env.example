# Copy to `.env` and fill in values. Do not commit `.env`.
#
# Next.js loads `.env`, `.env.local`, `.env.development`, etc. See:
# https://nextjs.org/docs/app/building-your-application/configuring/environment-variables

# -----------------------------------------------------------------------------
# Public (exposed to the browser — only use non-secret values)
# -----------------------------------------------------------------------------

# Pinpoint API origin for site content (no trailing slash).
# Used by server components and any client code that calls the same origin.
# Example: https://api.pinpoint.ng
NEXT_PUBLIC_PINPOINT_BACKEND_URL=

# Optional. Hostname only (no protocol/path) for CMS images not served from
# static.pinpoint.ng. Added to next.config.ts `images.remotePatterns` at build time.
# Example: cdn.example.com
NEXT_PUBLIC_CMS_IMAGE_HOSTNAME=

# -----------------------------------------------------------------------------
# Server-only
# -----------------------------------------------------------------------------

# Site origin for fallback metadata when the public CMS API is unreachable
# (see app/layout.tsx generateMetadata catch block). No trailing slash.
# Example: https://pinpoint.ng
live_url=

# --- Nodemailer (app/api/send-company-mail/route.ts) ---

# SMTP account used to send mail (login user and From address).
fromEmail=

# SMTP password or app password for fromEmail.
password=

# SMTP hostname (e.g. smtp.gmail.com).
emailHost=

# SMTP port (defaults to 465 if unset).
emailPort=

# Inbox that receives website form submissions.
toEmail=

# If set, passed to Boolean(); if unset, nodemailer uses secure: true.
# Note: any non-empty string is truthy in JS (including "false").
secureMail=
